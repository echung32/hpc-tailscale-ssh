# Copy this file to .env and fill in your values:
#   cp .env.example .env

# SLURM account to charge compute time to
ACCOUNT=my-slurm-account

# Email address for job BEGIN/END/FAIL notifications
EMAIL=you@example.com

# Absolute path to this proxy/ directory on the HPC filesystem
WORKING_DIR=/path/to/proxy

# Tailscale hostname advertised on the Tailnet.
# Must be unique across your tailnet.
TS_HOSTNAME=tailscale-proxy

# Tailscale instance name (for storing state / apptainer instance name)
# Must be unique across your tailnet.
TS_INSTANCE=tailscale-proxy

# Days before images/tailscale.sif is re-pulled from ghcr.io at job start.
# 0 refreshes on every submission; a large value disables the check.
TS_IMAGE_MAX_AGE_DAYS=7
